<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="vera" translate="label" sortOrder="710">
            <label>Vera</label>
        </tab>
        <section id="searchai" translate="label" type="text" sortOrder="10"
                 showInDefault="1" showInWebsite="1" showInStore="1">
            <label>SearchAI</label>
            <tab>vera</tab>
            <resource>Vera_SearchAI::config</resource>
            <group id="general" translate="label" type="text" sortOrder="10"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>
                <field id="enabled" translate="label" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable SearchAI</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="assistant_name" translate="label" type="text" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Assistant Name</label>
                </field>
                <field id="welcome_message" translate="label" type="textarea" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Welcome Message</label>
                </field>
                <field id="input_placeholder" translate="label" type="text" sortOrder="40"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Input Placeholder</label>
                </field>
                <field id="locations" translate="label comment" type="multiselect" sortOrder="50"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Show Chatbot On</label>
                    <source_model>Vera\SearchAI\Model\Config\Source\Locations</source_model>
                    <comment>Select one or more storefront locations.</comment>
                </field>
                <field id="max_history" translate="label comment" type="text" sortOrder="60"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Maximum Conversation History</label>
                    <validate>validate-number validate-greater-than-zero</validate>
                    <comment>Maximum 20 messages. The default is 6.</comment>
                </field>
            </group>
            <group id="ai" translate="label" type="text" sortOrder="20"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>AI Provider</label>
                <field id="provider" translate="label" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Provider</label>
                    <source_model>Vera\SearchAI\Model\Config\Source\Provider</source_model>
                </field>
                <field id="openai_model" translate="label" type="select" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>OpenAI Model</label>
                    <source_model>Vera\SearchAI\Model\Config\Source\OpenAIModel</source_model>
                    <depends><field id="provider">openai</field></depends>
                </field>
                <field id="openai_api_key" translate="label" type="obscure" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>OpenAI API Key</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <depends><field id="provider">openai</field></depends>
                </field>
                <field id="anthropic_model" translate="label" type="select" sortOrder="40"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Anthropic Model</label>
                    <source_model>Vera\SearchAI\Model\Config\Source\AnthropicModel</source_model>
                    <depends><field id="provider">anthropic</field></depends>
                </field>
                <field id="anthropic_api_key" translate="label" type="obscure" sortOrder="50"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Anthropic API Key</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <depends><field id="provider">anthropic</field></depends>
                </field>
                <field id="gemini_model" translate="label" type="select" sortOrder="60"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Gemini Model</label>
                    <source_model>Vera\SearchAI\Model\Config\Source\GeminiModel</source_model>
                    <depends><field id="provider">gemini</field></depends>
                </field>
                <field id="gemini_api_key" translate="label" type="obscure" sortOrder="70"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Gemini API Key</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <depends><field id="provider">gemini</field></depends>
                </field>
                <field id="custom_base_url" translate="label comment" type="text" sortOrder="80"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Custom Base URL</label>
                    <comment>HTTP or HTTPS OpenAI-compatible gateway URL.</comment>
                    <depends><field id="provider">custom</field></depends>
                </field>
                <field id="custom_endpoint" translate="label" type="text" sortOrder="90"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Custom Endpoint Path</label>
                    <depends><field id="provider">custom</field></depends>
                </field>
                <field id="custom_model" translate="label" type="text" sortOrder="100"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Custom Model ID</label>
                    <depends><field id="provider">custom</field></depends>
                </field>
                <field id="custom_api_key" translate="label" type="obscure" sortOrder="110"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Custom API Key</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <depends><field id="provider">custom</field></depends>
                </field>
                <field id="custom_auth_header" translate="label" type="text" sortOrder="120"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Authorization Header</label>
                    <depends><field id="provider">custom</field></depends>
                </field>
                <field id="custom_auth_prefix" translate="label" type="text" sortOrder="130"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Authorization Prefix</label>
                    <depends><field id="provider">custom</field></depends>
                </field>
            </group>
            <group id="catalog" translate="label" type="text" sortOrder="30"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Catalog</label>
                <field id="candidate_limit" translate="label comment" type="text" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Candidate Products</label>
                    <validate>validate-number validate-greater-than-zero</validate>
                    <comment>From 3 to 20. The default is 8.</comment>
                </field>
                <field id="use_short_description" translate="label" type="select" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Use Short Description</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="include_description" translate="label comment" type="select" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Include Full Description in AI Context</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Disabled by default to reduce tokens, cost, and latency.</comment>
                </field>
                <field id="additional_attributes" translate="label comment" type="text" sortOrder="40"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Additional Product Attributes</label>
                    <backend_model>Vera\SearchAI\Model\Config\Backend\AttributeCodes</backend_model>
                    <comment>Comma-separated public attribute codes, for example brand,color,size,material.</comment>
                </field>
                <field id="include_out_of_stock" translate="label" type="select" sortOrder="50"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Include Out-of-Stock Products</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>
            <group id="security" translate="label" type="text" sortOrder="40"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Security</label>
                <field id="requests_per_minute" translate="label" type="text" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Requests per Minute</label>
                    <validate>validate-number validate-greater-than-zero</validate>
                </field>
                <field id="max_query_length" translate="label" type="text" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Maximum Query Length</label>
                    <validate>validate-number validate-greater-than-zero</validate>
                </field>
                <field id="provider_timeout" translate="label" type="text" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Provider Timeout in Seconds</label>
                    <validate>validate-number validate-greater-than-zero</validate>
                </field>
                <field id="max_response_bytes" translate="label" type="text" sortOrder="40"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Maximum Provider Response Bytes</label>
                    <validate>validate-number validate-greater-than-zero</validate>
                </field>
            </group>
            <group id="advanced" translate="label" type="text" sortOrder="50"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Advanced</label>
                <field id="system_guidance" translate="label comment" type="textarea" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Additional System Guidance</label>
                    <comment>Store guidance is appended without replacing the built-in security rules.</comment>
                </field>
            </group>
        </section>
    </system>
</config>
