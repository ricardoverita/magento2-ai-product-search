<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Vera\SearchAI\Api\ProductRetrieverInterface"
                type="Vera\SearchAI\Model\Catalog\MagentoSearchRetriever"/>
    <preference for="Vera\SearchAI\Model\Ai\Http\HttpTransportInterface"
                type="Vera\SearchAI\Model\Ai\Http\MagentoHttpTransport"/>
    <type name="Vera\SearchAI\Model\Ai\ProviderPool">
        <arguments>
            <argument name="providers" xsi:type="array">
                <item name="openai" xsi:type="object">Vera\SearchAI\Model\Ai\Provider\OpenAI</item>
                <item name="anthropic" xsi:type="object">Vera\SearchAI\Model\Ai\Provider\Anthropic</item>
                <item name="gemini" xsi:type="object">Vera\SearchAI\Model\Ai\Provider\Gemini</item>
                <item name="custom" xsi:type="object">Vera\SearchAI\Model\Ai\Provider\CustomOpenAICompatible</item>
            </argument>
        </arguments>
    </type>
</config>
